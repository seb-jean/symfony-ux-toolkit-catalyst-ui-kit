{# @prop level number The heading level (1-6). #}
{# @block content The heading text. #}
{%- props level = 1 -%}
{%- set element = 'h' ~ level -%}
<{{ element }}
    {{ attributes.defaults({
        class: 'text-2xl/8 font-semibold text-zinc-950 sm:text-xl/8 dark:text-white',
    }) }}
>
    {%- block content %}{% endblock -%}
</{{ element }}>
