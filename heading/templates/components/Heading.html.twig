{%- props
    ## number The heading level (1-6).
    level = 1
-%}
{%- set element = 'h' ~ level -%}
<{{ element }}
    {{ attributes.defaults({
        class: 'text-2xl/8 font-semibold text-zinc-950 sm:text-xl/8 dark:text-white',
    }) }}
>
    {##- The heading text. -#}
    {%- block content %}{% endblock -%}
</{{ element }}>
