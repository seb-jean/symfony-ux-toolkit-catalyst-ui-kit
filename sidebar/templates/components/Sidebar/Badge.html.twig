{%- props
    ## string The color of the badge.
    color = 'zinc'
-%}
{%- set style = html_cva(
    base: 'ml-auto inline-flex min-w-6 shrink-0 items-center justify-center gap-x-1.5 rounded-md px-1.5 text-sm/6 font-medium tabular-nums sm:text-xs/5 forced-colors:outline',
    variants: {
        color: {
            red: 'bg-red-500/15 text-red-800 dark:bg-red-500/10 dark:text-red-400',
            orange: 'bg-orange-500/15 text-orange-800 dark:bg-orange-500/10 dark:text-orange-400',
            amber: 'bg-amber-400/20 text-amber-800 dark:bg-amber-400/10 dark:text-amber-400',
            yellow: 'bg-yellow-400/20 text-yellow-800 dark:bg-yellow-400/10 dark:text-yellow-300',
            lime: 'bg-lime-400/20 text-lime-800 dark:bg-lime-400/10 dark:text-lime-300',
            green: 'bg-green-500/15 text-green-800 dark:bg-green-500/10 dark:text-green-400',
            emerald: 'bg-emerald-500/15 text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-400',
            teal: 'bg-teal-500/15 text-teal-800 dark:bg-teal-500/10 dark:text-teal-300',
            cyan: 'bg-cyan-400/20 text-cyan-800 dark:bg-cyan-400/10 dark:text-cyan-300',
            sky: 'bg-sky-500/15 text-sky-800 dark:bg-sky-500/10 dark:text-sky-300',
            blue: 'bg-blue-500/15 text-blue-800 dark:text-blue-400',
            indigo: 'bg-indigo-500/15 text-indigo-800 dark:text-indigo-300',
            violet: 'bg-violet-500/15 text-violet-800 dark:text-violet-400',
            purple: 'bg-purple-500/15 text-purple-800 dark:text-purple-400',
            fuchsia: 'bg-fuchsia-400/15 text-fuchsia-800 dark:bg-fuchsia-400/10 dark:text-fuchsia-400',
            pink: 'bg-pink-400/15 text-pink-800 dark:bg-pink-400/10 dark:text-pink-400',
            rose: 'bg-rose-400/15 text-rose-800 dark:bg-rose-400/10 dark:text-rose-400',
            zinc: 'bg-zinc-950/5 text-zinc-600 dark:bg-white/5 dark:text-zinc-400',
        },
    },
) -%}
<span
    {{ attributes.defaults({
        class: style.apply({color: color}),
    }) }}
>
    {##- The badge label. -#}
    {%- block content %}{% endblock -%}
</span>
