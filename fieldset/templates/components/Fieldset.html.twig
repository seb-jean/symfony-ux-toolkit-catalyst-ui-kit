{%- props
    ## boolean Whether or not to disable the entire fieldset.
    disabled = false
-%}
{%- do provide('fieldset.disabled', disabled) -%}
<fieldset
    {% if disabled %}disabled{% endif %}
    {{ attributes.defaults({
        class: '*:data-[slot=text]:mt-1 [&>*+[data-slot=control]]:mt-6',
    }) }}
>
    {##- The fieldset content, typically includes `Legend`, `Text`, and `Fieldset:FieldGroup`. -#}
    {%- block content %}{% endblock -%}
</fieldset>
