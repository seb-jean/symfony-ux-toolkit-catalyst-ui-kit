{%- set _fieldsetField_disabled = inject('fieldsetField.disabled', false) -%}
<label
    data-slot="label"
    {% if _fieldsetField_disabled %}data-disabled{% endif %}
    {{ attributes.defaults({
        class: 'text-base/6 text-zinc-950 select-none data-disabled:opacity-50 sm:text-sm/6 dark:text-white',
    }) }}
>
    {##- The label text. -#}
    {%- block content %}{% endblock -%}
</label>
