{# @prop id string Unique identifier used to generate the mobile sidebar ID. #}
{# @block navbar The navbar, typically a `Navbar` component. #}
{# @block sidebar The sidebar, typically a `Sidebar` component. #}
{# @block content The page content. #}
{%- props id = 'sidebar-layout' -%}
{%- set _sidebar_id = id ~ '-mobile-sidebar' -%}
<div class="relative isolate flex min-h-svh w-full bg-white max-lg:flex-col lg:bg-zinc-100 dark:bg-zinc-900 dark:lg:bg-zinc-950">
    {# Sidebar on desktop #}
    <div class="fixed inset-y-0 left-0 w-64 max-lg:hidden">
        {%- block sidebar %}{% endblock -%}
    </div>

    {# Sidebar on mobile #}
    <el-dialog>
        <dialog id="{{ _sidebar_id }}" class="fixed inset-0 size-auto max-h-none max-w-none bg-transparent backdrop:bg-transparent lg:hidden">
            <el-dialog-backdrop class="fixed inset-0 bg-black/30 transition data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
            <el-dialog-panel class="fixed inset-y-0 w-full max-w-80 p-2 transition duration-300 ease-in-out data-closed:-translate-x-full">
                <div class="flex h-full flex-col rounded-lg bg-white shadow-xs ring-1 ring-zinc-950/5 dark:bg-zinc-900 dark:ring-white/10">
                    <div class="-mb-3 px-4 pt-3">
                        <twig:Navbar:Item aria-label="Close navigation" command="close" commandfor="{{ _sidebar_id }}">
                            <svg data-slot="icon" viewBox="0 0 20 20" aria-hidden="true">
                                <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                            </svg>
                        </twig:Navbar:Item>
                    </div>
                    {{ block('sidebar') }}
                </div>
            </el-dialog-panel>
        </dialog>
    </el-dialog>

    {# Navbar on mobile #}
    <header class="flex items-center px-4 lg:hidden">
        <div class="py-2.5">
            <twig:Navbar:Item aria-label="Open navigation" command="show-modal" commandfor="{{ _sidebar_id }}">
                <svg data-slot="icon" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M2 6.75C2 6.33579 2.33579 6 2.75 6H17.25C17.6642 6 18 6.33579 18 6.75C18 7.16421 17.6642 7.5 17.25 7.5H2.75C2.33579 7.5 2 7.16421 2 6.75ZM2 13.25C2 12.8358 2.33579 12.5 2.75 12.5H17.25C17.6642 12.5 18 12.8358 18 13.25C18 13.6642 17.6642 14 17.25 14H2.75C2.33579 14 2 13.6642 2 13.25Z" />
                </svg>
            </twig:Navbar:Item>
        </div>
        <div class="min-w-0 flex-1">
            {%- block navbar %}{% endblock -%}
        </div>
    </header>

    {# Content #}
    <main class="flex flex-1 flex-col pb-2 lg:min-w-0 lg:pt-2 lg:pr-2 lg:pl-64">
        <div class="grow p-6 lg:rounded-lg lg:bg-white lg:p-10 lg:shadow-xs lg:ring-1 lg:ring-zinc-950/5 dark:lg:bg-zinc-900 dark:lg:ring-white/10">
            <div class="mx-auto max-w-6xl">
                {%- block content %}{% endblock -%}
            </div>
        </div>
    </main>
</div>
