{%- props
    ## boolean Whether or not to disable the entire list.
    disabled = false
-%}
{%- do provide('radioGroup.disabled', disabled) -%}
<div
    data-slot="control"
    role="radiogroup"
    {{ attributes.defaults({
        class: html_classes(
            # Basic groups
            'space-y-3 **:data-[slot=label]:font-normal',
            # With descriptions
            'has-data-[slot=description]:space-y-6 has-data-[slot=description]:**:data-[slot=label]:font-medium',
        )
    }) }}
>
    {##- The radio fields. -#}
    {%- block content %}{% endblock -%}
</div>