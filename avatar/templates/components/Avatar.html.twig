{%- props
    ## string|null The URL of the avatar image.
    src = null,
    ## boolean Whether to make the avatar square.
    square = false,
    ## string|null The initials to use when no src is provided.
    initials = null,
    ## string The alt text of the avatar image.
    alt = ''
-%}
{%- set style = html_cva(
    base: [
        # Basic layout
        'inline-grid shrink-0 align-middle [--avatar-radius:20%] *:col-start-1 *:row-start-1',
        # Outline
        'outline -outline-offset-1 outline-black/10 dark:outline-white/10',
    ],
    variants: {
        square: {
            # Border radius
            true: 'rounded-(--avatar-radius) *:rounded-(--avatar-radius)',
            false: 'rounded-full *:rounded-full',
        },
    },
) -%}
<span
    data-slot="avatar"
    {{ attributes.defaults({
        class: style.apply({square: square}),
    }) }}
>
    {%- if initials -%}
        <svg
            class="size-full fill-current p-[5%] text-[48px] font-medium uppercase select-none"
            viewBox="0 0 100 100"
            {{ not alt ? 'aria-hidden="true"' }}
        >
            {%- if alt -%}<title>{{ alt }}</title>{%- endif -%}
            <text x="50%" y="50%" alignment-baseline="middle" dominant-baseline="middle" text-anchor="middle" dy=".125em">
                {{- initials -}}
            </text>
        </svg>
    {%- endif -%}
    {%- if src -%}
        <img class="size-full" src="{{ src }}" alt="{{ alt }}" />
    {%- endif -%}
</span>
